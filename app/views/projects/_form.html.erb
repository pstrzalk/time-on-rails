<%= form_with(model: project, class: "p-6 space-y-8") do |form| %>
  <% if project.errors.any? %>
    <div id="error_explanation" data-turbo-cache="false" class="bg-red-900/20 border border-red-800/30 rounded-lg p-4">
      <h4 class="text-white font-medium mb-2">Please fix the following errors:</h4>
      <ul class="text-red-100 space-y-1">
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>

  <% end %>

  <div class="space-y-3">
    <%= form.label :name, "Name *", class: "block text-sm font-semibold text-gray-200 mb-3" %>
    <%= form.text_field :name, class: ["w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-colors", {"border-gray-400 focus:outline-blue-600": project.errors[:name].none?, "border-red-400 focus:outline-red-600": project.errors[:name].any?}] %>
  </div>


  <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-800">
    <% label = project.persisted? ? "Update Project" : "Create Project" %>
    <%= form.submit label,
        class: "flex-1 bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
    <%= link_to "Cancel", works_path,
        class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-6 py-3 rounded-lg font-medium transition-colors text-center" %>
  </div>

<% end %>
