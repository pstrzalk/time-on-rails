<% content_for :title, "Projects" %>

<!-- Projects List -->
<div class="space-y-4">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-200">Projects</h2>
    <div class="text-sm text-gray-400"><%= pluralize(@projects.count, 'project') %></div>
  </div>

  <% if @projects.any? %>
    <% @projects.each do |project| %>
      <!-- Project Entry -->
      <div class="bg-gray-900 rounded-xl p-6 border border-gray-800 shadow-lg hover:border-gray-700 transition-colors">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="bg-gray-700 text-gray-200 px-3 py-1 rounded-full text-sm font-medium">Project</span>
            </div>
            <h3 class="text-white font-medium mb-2"><%= project.name %></h3>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-gray-400 text-sm">
              <span>Created <%= time_ago_in_words(project.created_at) %> ago</span>
            </div>
          </div>
          <div class="flex flex-col lg:flex-row items-start lg:items-center gap-4">
            <div class="flex gap-2">
              <%= link_to "Edit", edit_project_path(project), class: "bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
              <%= button_to "Delete", project, method: :delete, class: "bg-gray-800/50 hover:bg-gray-700/50 text-gray-400 hover:text-red-400 px-4 py-2 rounded-lg font-medium transition-colors", data: { turbo_confirm: "Are you sure you want to delete project #{project.name} and all its work logs?" } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-gray-900 rounded-xl p-8 border border-gray-800 text-center">
      <p class="text-gray-400 text-lg">No projects</p>
      <p class="text-gray-500 text-sm mt-2">Create your first project to get started!</p>
      <div class="mt-4">
        <%= link_to "Create Project", new_project_path, class: "bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
