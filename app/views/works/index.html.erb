<!-- Filter Section -->
<div class="mb-6">
  <form method="get" action="<%= works_path %>" class="flex items-center gap-4">
    <label for="project_id" class="text-gray-300 font-medium">Filter by</label>
    <select name="project_id" id="project_id" class="bg-gray-800 border border-gray-700 rounded-lg px-1 py-2 text-white focus:ring-2 focus:ring-orange-500 focus:border-transparent min-w-36" onchange="this.form.submit()">
      <option value="" <%= params[:project_id].blank? ? 'selected' : '' %>>All projects</option>
      <% @project_options.each do |name, id| %>
        <option value="<%= id %>" <%= params[:project_id].to_s == id.to_s ? 'selected' : '' %>><%= name %></option>
      <% end %>
    </select>

    <input type="hidden" name="only_this_month" value="<%= params[:only_this_month] == '1' ? '1' : '0' %>">
    <button class="<%= params[:only_this_month] == '1' ? "bg-orange-500" : "" %> border border-gray-700 hover:bg-orange-600 px-4 py-2 rounded-lg transition-colors" data-turbo="false" onclick="this.form.only_this_month.value = this.form.only_this_month.value === '1' ? '0' : '1'; this.form.submit()" >This Month Only</button>
  </form>
</div>

<!-- Works List -->
<div class="space-y-4">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-gray-200">Recent Work Sessions</h2>
    <div class="text-sm text-gray-400">
      <% if @total_pages > 1 %>
        Showing <%= (@current_page - 1) * @per_page + 1 %>-<%= [(@current_page * @per_page), @total_count].min %> of <%= pluralize(@total_count, 'session') %>
      <% else %>
        <%= pluralize(@total_count, 'session') %>
      <% end %>
    </div>
  </div>

  <% if @works.any? %>
    <div class="space-y-8">
      <% @works.group_by(&:date).each do |date, day_works| %>
        <!-- Day <%= date.iso8601 %> -->
        <section class="space-y-4" data-controller="day-group" data-day-group-date-value="<%= date.iso8601 %>">
          <h3>
            <button type="button" class="w-full flex flex-wrap items-center gap-x-3 gap-y-1 text-left cursor-pointer group" aria-expanded="true" aria-controls="works-day-<%= date.iso8601 %>" data-day-group-target="toggle" data-action="day-group#toggle">
              <svg class="w-4 h-4 text-gray-500 group-hover:text-gray-300 transition-transform" data-day-group-target="icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-200 font-semibold group-hover:text-white"><%= work_day_label(date) %></span>
              <span class="hidden sm:block flex-1 border-t border-gray-800"></span>
              <span class="text-sm text-gray-400 ml-7 sm:ml-0"><%= work_day_summary(**@day_totals.fetch(date)) %></span>
            </button>
          </h3>
          <div id="works-day-<%= date.iso8601 %>" class="space-y-4" data-day-group-target="entries">
            <% day_works.each do |work| %>
              <!-- Work Entry <%= work.in_progress? ? '- Running' : '' %> -->
              <div class="bg-gray-900 rounded-xl p-6 <%= work.in_progress? ? 'border-l-4 border-orange-500 border-r border-t border-b border-gray-800' : 'border border-gray-800' %> shadow-lg <%= work.in_progress? ? '' : 'hover:border-gray-700' %> transition-colors">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="bg-gray-700 text-gray-200 px-3 py-1 rounded-full text-sm font-medium"><%= work.project&.name || 'No Project' %></span>
                      <% if work.in_progress? %>
                        <div class="flex items-center gap-2">
                          <span class="text-orange-400 text-sm font-medium">Running</span>
                          <div class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></div>
                        </div>
                      <% else %>
                        <span class="text-gray-500 text-sm">Stopped</span>
                      <% end %>
                    </div>
                    <h4 class="text-white font-medium"><%= work.description.present? ? work.description : 'No description' %></h4>
                    <% if work.in_progress? %>
                      <div class="mt-2 text-gray-400 text-sm">Started <%= time_ago_in_words(work.started_at) %> ago</div>
            <% end %>
          </div>
          <div class="flex flex-col lg:flex-row items-start lg:items-center gap-4">
            <div class="text-right">
              <div class="<%= work.in_progress? ? 'text-2xl font-bold text-orange-400' : 'text-xl font-semibold text-gray-300' %>"><%= time_description(work.total_time) %></div>
            </div>
            <div class="flex gap-2">
              <% if work.in_progress? %>
                <%= link_to "Stop", stop_work_path(work), class: "bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors", data: { turbo_method: "post" } %>
              <% else %>
                <%= link_to "Start", start_work_path(work), class: "bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg font-medium transition-colors", data: { turbo_method: "post" } %>
              <% end %>
              <%= link_to "Edit", edit_work_path(work), class: "bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
              <%= button_to "Delete", work, method: :delete, class: "bg-gray-800/50 hover:bg-gray-700/50 text-gray-400 hover:text-red-400 px-4 py-2 rounded-lg font-medium transition-colors", data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </div>
        </div>
      </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-900 rounded-xl p-8 border border-gray-800 text-center">
      <p class="text-gray-400 text-lg">No work sessions found.</p>
      <p class="text-gray-500 text-sm mt-2">Create your first work session to get started!</p>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<% if @total_pages > 1 %>
  <div class="mt-6">
    <%= pagination_links(current_page: @current_page, total_pages: @total_pages, params: params) %>
  </div>
<% end %>
