<% content_for :title, "New work" %>

<!-- Breadcrumb -->
<div class="mb-6">
  <nav class="flex items-center space-x-2 text-sm text-gray-400">
    <%= link_to "Works", works_path, class: "hover:text-white transition-colors" %>
    <span>›</span>
    <span class="text-white">New work session</span>
  </nav>
</div>

<!-- Form Container -->
<div class="bg-gray-900 rounded-xl border border-gray-800 shadow-xl">
  <!-- Form Header -->
  <div class="border-b border-gray-800 p-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center">
        <span class="text-white text-lg">⏱</span>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-white">Create New Work Session</h1>
        <p class="text-gray-400 mt-1">Track your time on a project</p>
      </div>
    </div>
  </div>

  <!-- Form Content -->
  <%= render "form", work: @work %>
</div>

<!-- Additional Actions -->
<div class="mt-8 text-center">
  <%= link_to "← Back to works list", works_path, class: "text-gray-400 hover:text-white transition-colors text-sm" %>
</div>
